{
  "name": "desafio-quickfiller",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch src/server.ts\" \"npm --prefix frontend run dev\"",
    "dev:backend": "tsx watch src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "tsc",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node dist/server.js",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^5.1.1",
    "unpdf": "^1.8.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "pdfkit": "^0.19.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
